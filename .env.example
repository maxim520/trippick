# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key   # only used in ingest scripts, never in browser

# Feed URLs (add per source)
FEED_URL_DAISYCON_PRIJSVRIJ=https://...
FEED_URL_DAISYCON_DUTCHFLYGUYS=https://...
FEED_URL_TRADETRACKER_BUNGALOWNET=https://...
FEED_URL_DAISYCON_SOLMAR=https://...

# Ingest settings
PRICE_MIN_CENTS=5000          # €50
PRICE_MAX_CENTS=2500000       # €25.000
DEPARTURE_WINDOW_MONTHS=18
VOLUME_DROP_THRESHOLD=0.30    # alert if batch is >30% smaller than previous
PRICE_SHIFT_THRESHOLD=0.25    # alert if median price shifts >25%
